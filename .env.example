# Application
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Integration (Optional - Fallback to MockAiProvider when omitted)
GEMINI_API_KEY=

# Maps Integration (Optional - Fallback to MockMapsProvider when omitted)
GOOGLE_MAPS_API_KEY=

# Payment Integration (Optional - Fallback to MockPaymentProvider when omitted)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
